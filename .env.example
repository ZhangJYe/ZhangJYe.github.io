# Notion API
NOTION_TOKEN=

# Preferred: Notion Data Source ID
NOTION_DATA_SOURCE_ID=

# Optional fallback: Notion Database ID
# If this is set and NOTION_DATA_SOURCE_ID is empty, the script will use the first data source in the database.
NOTION_DATABASE_ID=

# Optional: accepted published status values, comma-separated
NOTION_STATUS_VALUES=Published,已发布

# Sync state file (for future incremental sync)
SYNC_STATE_FILE=.sync-state.json
